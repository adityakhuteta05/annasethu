# ====================================================================
# ANNASETU PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Populate these variables in your production container / cloud provider
# (e.g., Supabase Cloud, Vercel, Render, AWS Secrets Manager)
# ====================================================================

# 1. APPLICATION ENVIRONMENT
APP_ENV=production
FRONTEND_URL=https://annasetu.org
BACKEND_URL=https://api.annasetu.org

# 2. CLIENT PUBLIC CREDENTIALS (Vercel / Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://<production-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_APP_URL=https://annasetu.org
NEXT_PUBLIC_API_URL=https://api.annasetu.org

# 3. BACKEND HIGHLY SENSITIVE SECRETS (Render / FastAPI / Fly.io)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=<strong-random-production-jwt-secret-min-32-chars>

# 4. PRODUCTION THIRD-PARTY INTEGRATIONS (Private Backend Only)
GROQ_API_KEY=gsk_...
MAPS_API_KEY=<google-or-mapbox-production-key>
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=<razorpay-live-secret>

# 5. TRANSACTIONAL NOTIFICATIONS
EMAIL_PROVIDER_API_KEY=<resend-or-sendgrid-api-key>
EMAIL_FROM_ADDRESS=notifications@annasetu.org
EMAIL_FROM_NAME="AnnaSetu Food Rescue"
SMS_API_KEY=<dlt-registered-msg91-or-twilio-key>
PUSH_PROVIDER_KEY=<fcm-or-webpush-key>
PUSH_PROVIDER_SECRET=<fcm-or-webpush-secret>

# 6. AUTHORIZED GOVERNMENT VERIFICATION APIS (Optional)
GST_API_KEY=
FSSAI_API_KEY=
NGO_VERIFICATION_API_KEY=
VEHICLE_VERIFICATION_API_KEY=

# 7. SECURITY & RATE LIMITING
RATE_LIMIT_AUTH_PER_MINUTE=10
