# ====================================================================
# ANNASETU MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env at root or .env.local in apps/web
# NEVER commit real credentials to Git!
# ====================================================================

# --------------------------------------------------------------------
# 1. PUBLIC CLIENT ENVIRONMENT VARIABLES (Safe for browser / Next.js)
# --------------------------------------------------------------------
# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous public API key (Protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application frontend base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# --------------------------------------------------------------------
# 2. HIGHLY SENSITIVE BACKEND SECRETS (NEVER expose to browser bundles)
# --------------------------------------------------------------------
# Supabase service role secret for administrative database execution
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret for offline token decoding & verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars-long

# --------------------------------------------------------------------
# 3. PRIVATE INTEGRATION KEYS (Optional - Graceful Fallbacks Included)
# --------------------------------------------------------------------
# Groq AI Cloud API Key (llama-3.3-70b-versatile for assistive vision & copilot)
# Fallback: Deterministic food descriptions & manual integrity review
GROQ_API_KEY=

# Maps & Routing Provider Key (Google Maps / Mapbox / OpenStreetMap OSRM)
# Fallback: Stored coordinates + Haversine distance + 22 km/h urban ETA
MAPS_API_KEY=

# Razorpay Payment Gateway Credentials (Backend Only)
# Fallback: Seeded NGO demo wallets + simulated atomic ledger settlement
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Transactional Email Credentials (Resend / SendGrid / Amazon SES)
# Fallback: In-app realtime notification center
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notifications@annasetu.org
EMAIL_FROM_NAME="AnnaSetu Food Rescue"

# Transactional SMS Gateway (Twilio / MSG91 / Fast2SMS)
# Fallback: In-app realtime notification center
SMS_API_KEY=

# Web / Mobile Push Notification Credentials
PUSH_PROVIDER_KEY=
PUSH_PROVIDER_SECRET=

# Government Verification Integration Keys (Authorized GSP / API Providers)
# Fallback: MANUAL_LOOKUP_REQUIRED with official portal links + admin audit
GST_API_KEY=
FSSAI_API_KEY=
NGO_VERIFICATION_API_KEY=
VEHICLE_VERIFICATION_API_KEY=

# --------------------------------------------------------------------
# 4. APPLICATION & SECURITY CONTROLS
# --------------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
RATE_LIMIT_AUTH_PER_MINUTE=10
